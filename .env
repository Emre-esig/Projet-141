# ==============================
# URL PRINCIPALE API
# ==============================

/**
 * VITE_API_URL
 *
 * URL de base utilisée par Axios
 * pour envoyer les requêtes vers l'API Football.
 *
 * Cette valeur est récupérée dans :
 * src/plugins/axios.js
 *
 * grâce à :
 *
 * import.meta.env.VITE_API_URL
 */
VITE_API_URL=https://v3.football.api-sports.io



# ==============================
# CLE API
# ==============================

/**
 * VITE_API_KEY
 *
 * Clé personnelle API-Football.
 *
 * Cette clé permet :
 * - d'autoriser les requêtes
 * - d'identifier ton compte API
 * - de limiter l'accès aux utilisateurs autorisés
 *
 * Elle est utilisée dans axios.js :
 *
 * headers: {
 *   'x-apisports-key': API_KEY
 * }
 */
VITE_API_KEY=12e804a9f1d0a2b8a9da6f1951f992a2